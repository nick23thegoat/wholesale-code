# =====================================================================
# Wholesale Acquisition Engine — configuration
# =====================================================================
#
#   cp .env.example .env
#
# .env is git-ignored and is excluded from --backup unless you explicitly
# ask for it. Never commit real keys, and never paste one into source.
#
# The engine runs fully without any of this. With nothing set it starts in
# TEST mode, works from local CSV files and clearly-labelled fictional data,
# and says so on every run.
#
# No vendor is chosen for you. Picking one means reading that vendor's
# official API documentation, terms of service and pricing first. Use
# documented APIs with your own account, honour the published rate limits,
# and do not scrape sites or work around CAPTCHAs, robots.txt, logins,
# paywalls or anti-bot measures.

# ---------------------------------------------------------------------
# MODE
# ---------------------------------------------------------------------
# TEST (default) — local files and fictional demo data. Nothing billable.
# LIVE           — real provider APIs. REFUSES TO START if a required
#                  credential for a configured provider is missing.
WHOLESALE_MODE=TEST

# ---------------------------------------------------------------------
# PROVIDER SELECTION
# ---------------------------------------------------------------------
# Which adapter fills each slot. Every default is local and free.
# Run --provider-status to see what each one can actually do.
DATA_PROVIDER=csv
COMPS_PROVIDER=csv
SKIP_TRACE_PROVIDER=none
NOTIFICATION_PROVIDER=console
CRM_PROVIDER=none
SHEETS_PROVIDER=none
SMS_PROVIDER=none
EMAIL_PROVIDER=none
VOICE_PROVIDER=none
AI_PROVIDER=none

# ---------------------------------------------------------------------
# COST CONTROL
# ---------------------------------------------------------------------
# Caps per run, cheapest stage first. Conservative on purpose: a run that
# wants to research a thousand properties should have to say so.
MAX_RAW_LEADS=1000
MAX_RESEARCH=100
MAX_COMPS=30
MAX_SKIP_TRACES=10

# ---------------------------------------------------------------------
# PROPERTY DATA
# ---------------------------------------------------------------------
# Both are required before a live search will run. The base URL is the API
# root from your vendor's documentation — there is no default and the
# engine will not invent one.
PROPERTY_DATA_API_KEY=
PROPERTY_DATA_BASE_URL=

# ---------------------------------------------------------------------
# PUBLIC RECORDS (liens, tax status, foreclosure filings)
# ---------------------------------------------------------------------
# Optional. Without it, distress signals stay as reported by the lead
# source and are labelled unverified. Nothing is invented to fill the gap.
PUBLIC_RECORDS_API_KEY=

# ---------------------------------------------------------------------
# COMPARABLE SALES
# ---------------------------------------------------------------------
# Optional. Without it, supply comps by CSV or the ARV stays
# SOURCE-PROVIDED and cannot clear the verification gate.
COMPS_API_KEY=
COMPS_BASE_URL=

# ---------------------------------------------------------------------
# SKIP TRACING — NOT CONNECTED
# ---------------------------------------------------------------------
# Setting these does not enable contact lookups on its own: a vendor
# adapter with a real endpoint path is still required.
#
# Before you dial anyone: TCPA, state calling laws, DNC registries and
# CAN-SPAM apply. You need consent tracking and DNC scrubbing. The engine
# maintains the suppression list; the rest is yours.
SKIP_TRACE_API_KEY=
SKIP_TRACE_BASE_URL=

# ---------------------------------------------------------------------
# NOTIFICATIONS — BUILT, NOT CONNECTED
# ---------------------------------------------------------------------
NOTIFY_EMAIL_TO=
NOTIFY_WEBHOOK_URL=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------
# GOOGLE SHEETS — BUILT, NOT CONNECTED
# ---------------------------------------------------------------------
# Needs google-api-python-client, a service-account key, and the
# spreadsheet shared with that account's email. CSV and JSON exports work
# today and import into Sheets directly.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------
# CRM — BUILT, NOT CONNECTED
# ---------------------------------------------------------------------
CRM_API_KEY=
CRM_BASE_URL=

# ---------------------------------------------------------------------
# OUTREACH — BUILT, NOT CONNECTED, NOTHING IS SENT
# ---------------------------------------------------------------------
# SMS in the US needs 10DLC registration and working opt-out handling.
# Email needs CAN-SPAM compliance and a real unsubscribe. Recorded calls
# need state-by-state consent. Setting a key does not enable sending.
SMS_API_KEY=
SMS_FROM_NUMBER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
VOICE_API_KEY=
VOICE_FROM_NUMBER=

# ---------------------------------------------------------------------
# AI-ASSISTED NOTES — BUILT, NOT CONNECTED
# ---------------------------------------------------------------------
# Advisory output only. Decide deliberately what property data leaves your
# machine, and never put owner contact details in a prompt.
AI_API_KEY=
AI_MODEL=
