# =====================================================================
# Wholesale Acquisition Engine — configuration
# =====================================================================
#
#   cp .env.example .env
#
# .env is git-ignored and is excluded from --backup unless you explicitly
# ask for it. Never commit real keys, and never paste one into source.
#
# The engine runs fully without any of this. With nothing set it starts in
# TEST mode, works from local CSV files and clearly-labelled fictional data,
# and says so on every run.
#
# No vendor is chosen for you. Picking one means reading that vendor's
# official API documentation, terms of service and pricing first. Use
# documented APIs with your own account, honour the published rate limits,
# and do not scrape sites or work around CAPTCHAs, robots.txt, logins,
# paywalls or anti-bot measures.

# ---------------------------------------------------------------------
# MODE
# ---------------------------------------------------------------------
# TEST (default) — local files and fictional demo data. Nothing billable.
# LIVE           — real provider APIs. REFUSES TO START if a required
#                  credential for a configured provider is missing.
WHOLESALE_MODE=TEST

# ---------------------------------------------------------------------
# WHERE THE DATA LIVES
# ---------------------------------------------------------------------
# Blank means "inside the package" — wholesale_engine/data — which is right
# for a clone you run by hand.
#
# On a server, set this so the database survives a `git pull` and the code
# directory can stay read-only. It moves the database, the response cache and
# the API quota ledger together. It belongs in the systemd environment file
# (/etc/wholesale/env), not here — see deploy/README.md.
#
# Must be ABSOLUTE. A relative value is ignored rather than resolved against
# whatever the working directory happens to be, because that is how a service
# ends up creating a second, empty database beside the real one.
WHOLESALE_DATA_DIR=

# ---------------------------------------------------------------------
# PROVIDER SELECTION
# ---------------------------------------------------------------------
# Which adapter fills each slot. Every default is local and free.
# Run --provider-status to see what each one can actually do.
DATA_PROVIDER=csv
COMPS_PROVIDER=csv
SKIP_TRACE_PROVIDER=none
NOTIFICATION_PROVIDER=console
CRM_PROVIDER=none
SHEETS_PROVIDER=none
SMS_PROVIDER=none
EMAIL_PROVIDER=none
VOICE_PROVIDER=none
AI_PROVIDER=none

# ---------------------------------------------------------------------
# COST CONTROL
# ---------------------------------------------------------------------
# Caps per run, cheapest stage first. Conservative on purpose: a run that
# wants to research a thousand properties should have to say so.
MAX_RAW_LEADS=1000
MAX_RESEARCH=100
MAX_COMPS=25
MAX_SKIP_TRACES=10
# Ceiling on total billable calls to the property-data vendor in one run,
# sitting over MAX_RESEARCH and MAX_COMPS. The adapter enforces it too.
MAX_REACH=100

# ---------------------------------------------------------------------
# SEARCH PRICE RANGE
# ---------------------------------------------------------------------
# What the engine will LOOK AT — a buyer-capacity ceiling, not a deal rule.
# A property inside this range still has to clear ARV, repairs, the 70%
# rule, the end-buyer ceiling, MAO and the deal score like everything else.
# There is deliberately no low ceiling: a $1.4M house with a real spread is
# a lead, and a $60k house with no spread is not.
# Override per run with --min-price / --max-price.
MIN_PROPERTY_PRICE=0
MAX_PROPERTY_PRICE=2200000

# ---------------------------------------------------------------------
# RENTCAST  (--source rentcast)
# ---------------------------------------------------------------------
# Get a key at https://app.rentcast.io/app/api. It is sent as an X-Api-Key
# request header and is never logged, exported, or written to the cache.
#
# NEVER set this with `export RENTCAST_API_KEY=...` in your terminal — that
# writes the key to your shell history in plaintext. Instead:
#
#   read -rs RENTCAST_KEY                              # paste; nothing echoes
#   printf 'RENTCAST_API_KEY=%s\n' "$RENTCAST_KEY" >> .env
#   unset RENTCAST_KEY && chmod 600 .env
#
# RENTCAST_BASE_URL is optional; it defaults to https://api.rentcast.io/v1.
RENTCAST_API_KEY=
RENTCAST_BASE_URL=

# The free plan allows 50 successful requests per month, and going over incurs
# a per-request overage fee. The engine keeps its own local ledger and REFUSES
# to exceed this number. Raise it only when you actually upgrade the plan.
MAX_RENTCAST=50

# Requests held back from per-property valuations so a month's scheduled
# searches can always run. One search returns up to 500 records, so four
# covers a weekly cadence with one spare. A valuation is refused rather than
# allowed to eat the last search of the month.
RENTCAST_SEARCH_RESERVE=4

# ---------------------------------------------------------------------
# PROPERTYREACH  (--source propertyreach)
# ---------------------------------------------------------------------
# The key comes from the Keys tab of your PropertyReach account. It is sent
# as an x-api-key request header and is never written to a log or an export.
#
# PROPERTYREACH_BASE_URL is optional: the adapter defaults to the published
# API root, https://api.propertyreach.com/v1. Set it only to point at a
# different documented root.
#
# STATUS: the base URL, the x-api-key header and POST /v1/skip-trace are
# confirmed. The REST paths for Property Search, Property Detail and
# Comparables are NOT confirmed, and the adapter refuses to call an
# unconfirmed path rather than guess one. Fill them in from
# https://docs.propertyreach.com in providers/propertyreach_schema.py.
PROPERTYREACH_API_KEY=
PROPERTYREACH_BASE_URL=

# ---------------------------------------------------------------------
# PROPERTY DATA  (generic http-template adapter)
# ---------------------------------------------------------------------
# Both are required before a live search will run. The base URL is the API
# root from your vendor's documentation — there is no default and the
# engine will not invent one.
PROPERTY_DATA_API_KEY=
PROPERTY_DATA_BASE_URL=

# ---------------------------------------------------------------------
# PUBLIC RECORDS (liens, tax status, foreclosure filings)
# ---------------------------------------------------------------------
# Optional. Without it, distress signals stay as reported by the lead
# source and are labelled unverified. Nothing is invented to fill the gap.
PUBLIC_RECORDS_API_KEY=

# ---------------------------------------------------------------------
# COMPARABLE SALES
# ---------------------------------------------------------------------
# Optional. Without it, supply comps by CSV or the ARV stays
# SOURCE-PROVIDED and cannot clear the verification gate.
COMPS_API_KEY=
COMPS_BASE_URL=

# ---------------------------------------------------------------------
# SKIP TRACING — NOT CONNECTED
# ---------------------------------------------------------------------
# Setting these does not enable contact lookups on its own: a vendor
# adapter with a real endpoint path is still required.
#
# Before you dial anyone: TCPA, state calling laws, DNC registries and
# CAN-SPAM apply. You need consent tracking and DNC scrubbing. The engine
# maintains the suppression list; the rest is yours.
SKIP_TRACE_API_KEY=
SKIP_TRACE_BASE_URL=

# BATCHDATA  (SKIP_TRACE_PROVIDER=batchdata)
# A real, billed-per-lookup skip-trace vendor. Create a *server* token in your
# BatchData account; a *sandbox* token returns mock data at no cost, which is
# the right way to prove the wiring before spending on a real batch.
#
# Store it the same way as the RentCast key — never with `export`, which
# writes it into your shell history:
#
#   read -rs BATCH_KEY
#   printf 'BATCHDATA_API_KEY=%s\n' "$BATCH_KEY" >> .env
#   unset BATCH_KEY && chmod 600 .env
#
# Setting this key is what makes real contact lookups possible. It does NOT
# make them lawful: that is still consent tracking, DNC scrubbing and the
# suppression list, and none of it happens automatically.
BATCHDATA_API_KEY=

# Your contracted per-lookup rate, for the cost report. Left blank the report
# says "unknown" rather than "free" — no price is ever invented for you.
SKIP_TRACE_COST_PER_LOOKUP=

# ---------------------------------------------------------------------
# NOTIFICATIONS — BUILT, NOT CONNECTED
# ---------------------------------------------------------------------
NOTIFY_EMAIL_TO=
NOTIFY_WEBHOOK_URL=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------
# GOOGLE SHEETS — BUILT, NOT CONNECTED
# ---------------------------------------------------------------------
# Needs google-api-python-client, a service-account key, and the
# spreadsheet shared with that account's email. CSV and JSON exports work
# today and import into Sheets directly.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------
# CRM — BUILT, NOT CONNECTED
# ---------------------------------------------------------------------
CRM_API_KEY=
CRM_BASE_URL=

# ---------------------------------------------------------------------
# OUTREACH — BUILT, NOT CONNECTED, NOTHING IS SENT
# ---------------------------------------------------------------------
# SMS in the US needs 10DLC registration and working opt-out handling.
# Email needs CAN-SPAM compliance and a real unsubscribe. Recorded calls
# need state-by-state consent. Setting a key does not enable sending.
SMS_API_KEY=
SMS_FROM_NUMBER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
VOICE_API_KEY=
VOICE_FROM_NUMBER=

# ---------------------------------------------------------------------
# AI-ASSISTED NOTES — BUILT, NOT CONNECTED
# ---------------------------------------------------------------------
# Advisory output only. Decide deliberately what property data leaves your
# machine, and never put owner contact details in a prompt.
AI_API_KEY=
AI_MODEL=
